# LOCAL Supabase (runs in Docker via `supabase start` — NOT the hosted cloud).
# The app and these values all point at the local instance on 127.0.0.1.
# Get the real values from `supabase status` (Studio UI: http://127.0.0.1:54323).

# Browser-safe values. These are embedded at build time by Vite.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server / Docker runtime values. Never prefix service-role values with VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional external integration.
VITE_RTS_API_URL=
VITE_RTS_API_KEY=
