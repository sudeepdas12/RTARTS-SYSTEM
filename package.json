{
  "name": "rtarts-system",
  "description": "RBB Merchant Banking Limited - RTS / RTARTS Management System",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "RBB Merchant Banking Limited",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:upload": "playwright test e2e/uploads-all-sections.spec.ts",
    "db:backup": "node ./scripts/ops/backup-db.mjs",
    "db:restore": "node ./scripts/ops/restore-db.mjs",
    "db:backup:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/ops/backup-db.ps1",
    "db:restore:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/ops/restore-db.ps1",
    "verify:edge": "node ./scripts/ops/verify-edge-parity.mjs",
    "verify:db": "node ./scripts/ops/check-supabase-health.mjs",
    "verify:release-gate": "node ./scripts/ops/release-gate-verify.mjs",
    "audit:source-release": "node ./scripts/ops/release-gate-verify.mjs --source",
    "verify:production-live": "node ./scripts/ops/release-gate-verify.mjs --live",
    "audit:classifications": "node ./scripts/audit/audit-classifications.mjs",
    "audit:summaries": "node ./scripts/audit/audit-all-summaries.mjs",
    "fixtures:generate": "node ./scripts/generate_all_test_fixtures.mjs",
    "test:fixtures": "tsx ./scripts/verify_upload_fixtures.ts",
    "prepare": "husky"
  },
